# ==============================================================================
# Dotfiles Environment & Secret Configuration Template
# ==============================================================================
# Instructions: Copy to .env (or .env.local) and populate.
# DO NOT commit .env or secrets to git.

# AI CLI & Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Location Coordinates for Nightlight / Gammastep (Decimal)
NIGHTLIGHT_LAT=0.0
NIGHTLIGHT_LON=0.0
NIGHTLIGHT_TEMP_DAY=6500
NIGHTLIGHT_TEMP_NIGHT=3000

# Spotify Client Credentials (for spotify-player)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Host / System Roles
DOTFILES_HOST_ROLE=desktop  # [desktop, laptop, server]
