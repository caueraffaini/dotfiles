font-family = JetBrainsMono Nerd Font
font-size = 13

# Colors (Tokenized Gruvbox Material Dark)
background = #282828
foreground = #ebdbb2
selection-background = #504945
selection-foreground = #ebdbb2
cursor-color = #fabd2f

# Palette
palette = 0=#282828
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#bdae93
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
window-decoration = false

font-feature = +ss01
bold-is-bright = false

scrollback-limit = 100000
copy-on-select = false
confirm-close-surface = false

keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
