# Neovim state (managed by lazy.nvim, per-machine lock)
nvim/.config/nvim/lazy-lock.json

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Machine-local overlays & secret extensions
*.local
!scripts/.local/
*.local.*
*.secret
*.token
*.key
*.pem
*.pfx
*.p12
*.age
*.sops
.env
.env.*
!.env.example
*.conf.local
local-overrides/

# Private Credentials & Token Stores
credentials.json
service-account*.json
rclone.conf
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
.netrc
.npmrc
.pypirc
*.kdbx
*.ovpn

# Runtime State & Logs
*.log
ai-logs/
.system_generated/
.*_history
.history
.python_history
.lesshst

# Editor temporary & swap files
*~
*.swp
*.swo
.DS_Store
.directory

# Machine-local / dynamic runtime carve-outs
waybar/.config/waybar/k10temp
hypr/.config/hypr/hypridle.conf
