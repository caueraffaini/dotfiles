-- Refined editorial Gruvbox — design tokens
-- Spacing : 4 / 8 / 12 / 16 / 24
-- Radius  : outer = 10, inner = 4, atomic = 0
-- Accent  : br-yellow ({{br_yellow}}) = active focus  ·  bg3 ({{bg3}}) = recede

hl.config({
	general = {
		gaps_in = 4,
		gaps_out = 16,
		border_size = 2,
		col = {
			active_border   = "rgba({{br_yellow_hex}}ee)",
			inactive_border = "rgba({{bg1_hex}}aa)",
		},
		resize_on_border = false,
		allow_tearing = false,
		layout = "dwindle",
	},

	decoration = {
		rounding = 10,
		rounding_power = 2,
		active_opacity = 1.0,
		inactive_opacity = 1.0,
		shadow = {
			enabled = true,
			range = 16,
			render_power = 3,
			color = 0x661a1a1a,
		},
		blur = {
			enabled = true,
			size = 6,
			passes = 3,
			vibrancy = 0.1696,
		},
	},

	animations = {
		enabled = true,
	},

	misc = {
		force_default_wallpaper = 0,
		disable_hyprland_logo = true,
	},

	dwindle = {
		preserve_split = true,
	},

	master = {
		new_status = "master",
	},

	scrolling = {
		fullscreen_on_one_column = true,
	},
})

-- ── Move 5: Normalized Motion Language ──
-- High-signal beziers/springs for editorial cubic-out motion
hl.curve("editorial",       { type = "bezier", points = { { 0.32, 0.72 },     { 0, 1 }           } })
hl.curve("snappy",          { type = "bezier", points = { { 0.15, 0 },        { 0.1, 1 }         } })
hl.curve("linear",          { type = "bezier", points = { { 0, 0 },           { 1, 1 }           } })
hl.curve("easy",            { type = "spring", mass = 1, stiffness = 71.2633, dampening = 15.8273644 })

-- Normalized 9 animation leaves
hl.animation({ leaf = "global",         enabled = true, speed = 4,    bezier = "editorial"    })
hl.animation({ leaf = "windows",        enabled = true, speed = 4.8,  spring = "easy"         })
hl.animation({ leaf = "windowsIn",      enabled = true, speed = 4.1,  spring = "easy",   style = "popin 87%" })
hl.animation({ leaf = "windowsOut",     enabled = true, speed = 1.5,  bezier = "linear", style = "popin 87%" })
hl.animation({ leaf = "layers",         enabled = true, speed = 3.8,  bezier = "editorial"    })
hl.animation({ leaf = "fade",           enabled = true, speed = 3.0,  bezier = "snappy"       })
hl.animation({ leaf = "workspaces",     enabled = true, speed = 2.0,  bezier = "editorial", style = "fade" })
hl.animation({ leaf = "border",         enabled = true, speed = 5.4,  bezier = "editorial"    })
hl.animation({ leaf = "zoomFactor",     enabled = true, speed = 7.0,  bezier = "snappy"       })
